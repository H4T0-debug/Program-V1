-- FORCE MOBILE ENTER INTERCEPTION
local isInsertingLine = false
codeInput.FocusLost:Connect(function(enterPressed)
	if enterPressed and not isInsertingLine then
		isInsertingLine = true
		codeInput.Text = codeInput.Text .. "\n"
		task.defer(function()
			codeInput:CaptureFocus()
			isInsertingLine = false
		end)
	end
end)

