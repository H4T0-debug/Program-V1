runButton.MouseButton1Click:Connect(function()
	local code = codeInput.Text
	if code == "" then
		printOutput("[WARN] Code box is empty!", Color3.fromRGB(255, 180, 60))
		return
	end

	local ext = targetFilename:match("%.([^%.]+)$") or ""
	ext = string.lower(ext)
	local language = EXTENSION_MAP[ext] or ext

	printOutput("[EXECUTING] Sending " .. language .. " code to backend...", Color3.fromRGB(255, 200, 80))

	task.spawn(function()
		if not httpReq then
			printOutput("[ERROR] Executor request function missing!", Color3.fromRGB(255, 80, 80))
			return
		end

		local payload = HttpService:JSONEncode({
			language = language,
			code = code,
			filename = targetFilename
		})

		local response
		local success, err = pcall(function()
			response = httpReq({
				Url = BACKEND_URL .. "/execute",
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = payload
			})
		end)

		if not success then
			printOutput("[HTTP FATAL ERROR]:", Color3.fromRGB(255, 80, 80))
			printOutput(tostring(err), Color3.fromRGB(255, 80, 80))
			return
		end

		if response then
			local body = response.Body or ""
			local decodeSuccess, data = pcall(function()
				return HttpService:JSONDecode(body)
			end)

			if decodeSuccess and type(data) == "table" then
				if data.output then
					printOutput("[OUTPUT]:", Color3.fromRGB(0, 230, 120))
					for _, line in ipairs(string.split(data.output, "\n")) do
						if line ~= "" then printOutput("  " .. line, Color3.fromRGB(230, 230, 230)) end
					end
				elseif data.run and data.run.output then
					printOutput("[OUTPUT]:", Color3.fromRGB(0, 230, 120))
					for _, line in ipairs(string.split(data.run.output, "\n")) do
						if line ~= "" then printOutput("  " .. line, Color3.fromRGB(230, 230, 230)) end
					end
				elseif data.error then
					printOutput("[SERVER ERROR]:", Color3.fromRGB(255, 80, 80))
					printOutput(tostring(data.error), Color3.fromRGB(255, 80, 80))
				elseif data.message then
					printOutput("[SERVER ERROR]:", Color3.fromRGB(255, 80, 80))
					printOutput(tostring(data.message), Color3.fromRGB(255, 80, 80))
				else
					printOutput("[RAW RESPONSE]:", Color3.fromRGB(255, 180, 60))
					printOutput(body, Color3.fromRGB(255, 180, 60))
				end
			else
				printOutput("[RAW RESPONSE]:", Color3.fromRGB(255, 80, 80))
				printOutput(body, Color3.fromRGB(255, 80, 80))
			end
		end
	end)
end)